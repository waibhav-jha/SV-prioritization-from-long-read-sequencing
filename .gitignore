# ==========================================
# Git Ignore Configuration
# Project: SV Prioritization from Long-Read Sequencing
# ==========================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Caching & Jupyter Notebook checkpoints
.ipynb_checkpoints/
.pytest_cache/
*.swp
*.swo

# Virtual Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Raw Genomic Archives (>100MB - ClinVar 421MB, gnomAD 134MB dumps)
raw/

# Redundant duplicate processed datasets (canonical data preserved in processed/)
data/
eda/data/
eda/processed/

# Node & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE, Agent Skills & Scratch Workspace
.agents/
scratch/

# Temporary office lock files and OS artifacts
~$*.pptx
~$*.docx
*.tmp
Thumbs.db
.DS_Store

# Duplicate notebook folder (canonical in notebooks/)
notebook/
